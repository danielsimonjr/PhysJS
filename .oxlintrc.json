{
  "plugins": ["typescript", "oxc"],
  "env": {
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/*.d.ts"],
  "rules": {
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error"
  }
}
