{
  "name": "physjs",
  "version": "0.0.0",
  "private": true,
  "description": "PhysJS monorepo: a TypeScript physics engine built on MathTS.",
  "author": "Daniel Simon Jr.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "core",
    "functions"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test && vitest run",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --deny-warnings core/src functions/src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.4.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/PhysJS.git"
  }
}
